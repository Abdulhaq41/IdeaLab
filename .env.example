# Local browser demo; never use DEMO_MODE=true together with NODE_ENV=production.
NODE_ENV=development
DEMO_MODE=true
PORT=3000
# Production uses PostgreSQL. Demo uses .data/idealab.sqlite and ignores DATABASE_URL.
DATABASE_URL=postgresql://idealab:CHANGE_LOCALLY@db:5432/idealab
POSTGRES_USER=idealab
POSTGRES_PASSWORD=CHANGE_LOCALLY
POSTGRES_DB=idealab
# Production: set a real HTTPS hostname and your actual support route.
PUBLIC_URL=https://your-domain.example
SUPPORT_URL=
# Secrets: use your deployment's encrypted secret settings. Never commit .env.
BOT_TOKEN=
SESSION_SECRET=
WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
# Test Telegram API: only in non-production, with a separate test bot and database.
TELEGRAM_TEST=false
# Optional bounded explanation service. No key is needed to play.
AI_API_KEY=
AI_ENDPOINT=
AI_MODEL=gpt-4.1-mini
AI_DAILY_REQUEST_CAP=20
